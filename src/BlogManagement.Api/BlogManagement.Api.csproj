<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
	<ProjectReference Include="..\BlogManagement.Application\BlogManagement.Application.csproj" />
	<ProjectReference Include="..\BlogManagement.Infrastructure\BlogManagement.Infrastructure.csproj" />
	<ProjectReference Include="..\BlogManagement.Shared\BlogManagement.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
	<PackageReference Include="Swashbuckle.AspNetCore" Version="6.8.0" />
	<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="appsettings.Local.json" />
    <Content Include="appsettings.Local.json" Condition="Exists('appsettings.Local.json')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <Target Name="PrepareVisualStudioLocalDb" BeforeTargets="PrepareForBuild"
          Condition="'$(BuildingInsideVisualStudio)' == 'true' and '$(Configuration)' == 'Debug' and '$(DesignTimeBuild)' != 'true' and '$(OS)' == 'Windows_NT'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../../scripts/Prepare-LocalDb.ps1&quot;" />
    <ItemGroup>
      <Content Remove="appsettings.Local.json" />
      <Content Include="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    </ItemGroup>
  </Target>
</Project>
